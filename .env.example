# Copy to .env.local. Values already exported in your shell also work.

# Required
# https://www.assemblyai.com/dashboard (one key for STT, LLM Gateway and TTS)
ASSEMBLYAI_API_KEY=
# https://platform.parallel.ai
PARALLEL_API_KEY=

# LiveKit server. These are the defaults of `livekit-server --dev`.
# For LiveKit Cloud, run `lk cloud auth` and use your project's values.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Optional ---------------------------------------------------------------
# local (AssemblyAI direct, no LiveKit Cloud) | cloud (LiveKit Inference + ai-coustics)
# AGENT_STACK=local
# api (direct Search/Decisions tools) | mcp (hosted Parallel MCP server)
# PARALLEL_TOOL_SOURCE=api
# LLM Gateway model for the local stack (must support tools + stream)
# LLM_MODEL=claude-haiku-4-5-20251001
# ASSEMBLYAI_STT_MODEL=universal-3-6-pro
# ASSEMBLYAI_TTS_VOICE=aai-violet
# AGENT_GREETING=Hi! I can look anything up on the web for you. What's up?
# turbo (voice default) | fast | basic | advanced
# PARALLEL_SEARCH_MODE=turbo
# PARALLEL_MAX_CHARS=4000
# PARALLEL_MAX_RESULTS=5
